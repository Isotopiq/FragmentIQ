APP_NAME=FragmentIQ
ENVIRONMENT=production
DATABASE_URL=sqlite:///./data/database/fragmentiq.db
STORAGE_ROOT=./data
UPLOAD_MAX_MB=2048
MOCK_EXECUTION=true
MOCK_JOB_STEP_SECONDS=0.25
JOB_TIMEOUT_SECONDS=7200
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MZMINE_BINARY=mzmine
MZMINE_BATCH_FLAG=-batch
SIRIUS_BINARY=sirius
VITE_API_BASE=/api
