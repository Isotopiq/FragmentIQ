APP_NAME=FragmentIQ
ENVIRONMENT=production
DATABASE_URL=sqlite:///./data/database/fragmentiq.db
STORAGE_ROOT=./data
UPLOAD_MAX_MB=2048
MOCK_EXECUTION=true
MOCK_JOB_STEP_SECONDS=0.25
JOB_TIMEOUT_SECONDS=7200
CORS_ORIGINS=http://localhost:5173,http://localhost:47831,http://localhost:47832
VITE_API_BASE=/api

# MZmine (batch workflow engine)
MZMINE_BINARY=mzmine
MZMINE_BATCH_FLAG=-batch
MZMINE_MEMORY_MODE=none
MZMINE_TEMP_DIR=/tmp/mzmine

# SIRIUS (CLI or REST API)
SIRIUS_BINARY=sirius
SIRIUS_USE_API=false
SIRIUS_API_URL=
SIRIUS_USERNAME=
SIRIUS_PASSWORD=
SIRIUS_ACCEPT_TERMS=false

# MS2Query and DreaMS
MS2QUERY_LIBRARY_DIR=./data/libraries/ms2query
DREAMS_CACHE_DIR=./data/models/dreams
MATCHMS_TOP_K=5
